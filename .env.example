# ============================================================
# Configuración del sistema (copiar a .env y completar)
# NUNCA subas el archivo .env al repositorio.
# ============================================================

# Clave API de Huawei Cloud MaaS (la entrega la organización)
MAAS_API_KEY=

# Endpoint compatible con OpenAI de MaaS.
# Acepta la URL completa (https://host/v2/chat/completions)
# o la base estilo OpenAI (http://host:4000/v1), que se completa sola.
MAAS_ENDPOINT=https://api-ap-southeast-1.modelarts-maas.com/v2/chat/completions

# Modelo a usar (el que indique la organización)
MAAS_MODEL=glm-5.2

# Tiempo máximo de espera por llamada al modelo, en segundos
# (una fase puede tardar entre 1 y 3 minutos)
MAAS_TIMEOUT=300

# Temperatura baja para salidas estables
MAAS_TEMPERATURE=0.1

# Reintentos ante JSON inválido o errores de validación de contrato
MAAS_MAX_REINTENTOS=3

# Verificación SSL del endpoint (true en producción)
MAAS_VERIFY_SSL=true

# 1 = ejecutar sin llamar al modelo (salidas simuladas, para probar la tubería)
MAAS_MOCK=0
